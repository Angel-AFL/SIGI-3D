# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (nueva) o, si usas las claves legacy, la anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: nunca exponer con prefijo NEXT_PUBLIC_.
# Secret key (nueva) o, si usas las claves legacy, la service_role key.
SUPABASE_SECRET_KEY=

# Web Push (VAPID). Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# DeepSeek (solo servidor)
DEEPSEEK_API_KEY=
